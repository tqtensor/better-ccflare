# Local build Dockerfile — copies a pre-built binary from apps/cli/dist/
# instead of downloading from GitHub releases. Use this when you want to
# ship your own changes (not yet in a public release) to a private registry.
#
# Build steps:
#   bun run build                                # build dashboard + CLI from repo root
#   cd apps/cli && bun run build:linux-amd64     # or build:linux-arm64
#   cd ../..
#   docker build -f Dockerfile.local \
#     --build-arg TARGETARCH=amd64 \
#     -t <registry>/<repo>/better-ccflare:<tag> .
#   docker push <registry>/<repo>/better-ccflare:<tag>

FROM debian:bookworm-slim

# TARGETARCH picks the right local binary (amd64 or arm64).
# Automatically set by `docker buildx`; for plain `docker build` pass it
# with --build-arg TARGETARCH=amd64.
ARG TARGETARCH=amd64

# Install runtime deps
RUN apt-get update && \
    apt-get install -y \
      sqlite3 \
      ca-certificates \
      curl \
      && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the locally-built binary into the image.
# Make sure you've run `bun run build:linux-${TARGETARCH}` in apps/cli first.
COPY apps/cli/dist/better-ccflare-linux-${TARGETARCH} /usr/local/bin/better-ccflare
RUN chmod +x /usr/local/bin/better-ccflare && \
    /usr/local/bin/better-ccflare --version

# Non-root user + data dir
RUN useradd -r -u 1000 -m -s /bin/bash ccflare && \
    mkdir -p /data /app/logs && \
    chown -R ccflare:ccflare /data /app/logs

ENV NODE_ENV=production \
    BETTER_CCFLARE_DB_PATH=/data/better-ccflare.db \
    BETTER_CCFLARE_LOG_DIR=/app/logs

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

LABEL org.opencontainers.image.title="better-ccflare" \
      org.opencontainers.image.description="Load balancer proxy for Claude API (local build)"

USER ccflare
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/better-ccflare"]
CMD ["--serve", "--port", "8080"]
